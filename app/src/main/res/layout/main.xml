<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg">

    <!-- Scrollable Content -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="200dp"> <!-- Space for Header -->

        <ListView
            android:id="@+id/folderListView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="20dp"
            android:clipToPadding="false" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Header Section (Stays on Top) -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/dashboard_modern_bg"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTotalStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 Items Saved"
            android:textColor="@color/text_white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/tvLastSync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last Sync: Never"
            android:textColor="#B0FFFFFF"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnStartBackup"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Sync Now"
                android:textAllCaps="false"
                android:backgroundTint="@color/surface_card"
                android:textColor="@color/brand_deep"
                android:textStyle="bold" />

            <View android:layout_width="12dp" android:layout_height="0dp"/>

            <ImageButton
                android:id="@+id/btnLogs"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/ic_history_modern"
                android:background="@drawable/button_white_bg"
                android:padding="12dp"
                android:scaleType="fitCenter" />

            <View android:layout_width="12dp" android:layout_height="0dp"/>

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/ic_settings_modern"
                android:background="@drawable/button_white_bg"
                android:padding="12dp"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </LinearLayout>

    <!-- Floating Search Bar -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_below="@id/header"
        android:layout_marginTop="-27dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:background="@drawable/search_bar_bg"
        android:elevation="8dp"
        android:hint="Search your gallery..."
        android:paddingLeft="20dp"
        android:drawableLeft="@android:drawable/ic_menu_search"
        android:drawablePadding="10dp"
        android:singleLine="true" />

</RelativeLayout>